# 카카오 API 키 (AGENTS.md 13, 18장)
# 이 파일은 "어떤 키가 필요한지" 알려주는 예시다. 실제 값은 .env 에 넣는다.
# .env 는 .gitignore 되어 커밋되지 않는다.

# REST API 키: 서버(Vite dev 프록시)에서만 사용. 브라우저에 노출되면 안 되므로
# VITE_ 접두사를 붙이지 않는다. 자차/대중교통/도보/로컬 길찾기 호출에 쓴다.
KAKAO_REST_API_KEY=

# JavaScript 키: 브라우저 카카오맵 SDK(지도 표시)에서 사용. VITE_ 접두사로 노출 허용.
VITE_KAKAO_JS_KEY=

# 서울 실시간 도시데이터 인증키 (열린데이터광장). 혼잡도 조회에 사용.
# 서버(dev 프록시)에서 URL 경로에 삽입하므로 VITE_ 접두사를 붙이지 않는다.
SEOUL_CITYDATA_KEY=
